<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:orientation="horizontal"
    android:layout_margin="5dp"
    android:background="@drawable/rounded_and_border"
    android:elevation="5dp"
    android:padding="6dp">

    <ImageView
        android:id="@+id/rewardImage"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.25"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:src="@drawable/giftbox"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.65"
        android:layout_marginRight="10dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/rewardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RewardTitle"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:fontFamily="sans-serif"
            android:textColor="#212121"
            android:textStyle="bold"
            android:textSize="18sp"/>

        <TextView
            android:id="@+id/rewardPointsCost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RewardDetails"
            android:paddingLeft="10dp"
            android:textColor="#757575"
            android:textSize="12sp"/>

    </LinearLayout>

    <TextView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.10"
        android:text="o"
        android:textSize="20sp"
        android:layout_marginRight="5dp"
        android:gravity="center"
        android:textColor="#BDBDBD"/>

</LinearLayout>