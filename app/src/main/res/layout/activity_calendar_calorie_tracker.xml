<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7F2">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <FrameLayout
            android:id="@+id/calendarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp">

            <CalendarView
                android:id="@+id/calendarView"
                android:layout_width="395dp"
                android:layout_height="365dp"
                android:layout_gravity="center_horizontal" />

            <View
                android:id="@+id/calendarDayCover"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start"
                android:layout_marginStart="72dp"
                android:layout_marginTop="140dp"
                android:background="#4CAF50"
                android:alpha="0.5" />

            <View
                android:id="@+id/calendarDayCover2"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start"
                android:layout_marginStart="24dp"
                android:layout_marginTop="140dp"
                android:background="#4CAF50"
                android:alpha="0.2" />
        </FrameLayout>

        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/calendarContainer"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="24dp"
            android:text="Daily Intake"
            android:textColor="#2E7D32"
            android:textSize="28sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recordsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/screenTitle"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_food_card" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addButton"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_below="@id/recordsRecyclerView"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#4CAF50"
            android:elevation="4dp"
            android:text="+ Log New Meal"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="32dp" />

    </RelativeLayout>
</ScrollView>